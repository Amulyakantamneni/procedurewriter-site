# Copy this file to .env for local development with `vercel dev`.
# In production, set these as Environment Variables in the Vercel project dashboard instead.

# Required. Your Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=

# Optional. If set, the /api/generate-procedure endpoint requires this exact
# value in the X-Access-Code request header. Leave blank to leave the
# endpoint open to anyone who finds the URL — not recommended once it's live.
GENERATOR_ACCESS_CODE=
